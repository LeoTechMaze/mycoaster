      "item": [
        {
          "name": "Geo Search",
          "item": [
            {
              "name": "Within radius — returns CW with distance_km",
              "request": {
                "method": "GET",
                "url": {
                  "raw": "{{baseUrl}}/api/v1/parks?lat=43.843&lng=-79.537&radius=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "parks"],
                  "query": [
                    { "key": "lat",    "value": "43.843" },
                    { "key": "lng",    "value": "-79.537" },
                    { "key": "radius", "value": "10" }
                  ]
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "const json = pm.response.json();",
                      "",
                      "pm.test('Status 200', () => pm.response.to.have.status(200));",
                      "",
                      "pm.test('Returns an array', () => {",
                      "  pm.expect(json.data).to.be.an('array');",
                      "});",
                      "",
                      "pm.test(\"Canada's Wonderland is in results\", () => {",
                      "  const cw = json.data.find(p => p.id === pm.collectionVariables.get('CW_ID'));",
                      "  pm.expect(cw).to.exist;",
                      "});",
                      "",
                      "pm.test('Each result has a numeric distance_km', () => {",
                      "  json.data.forEach(p => pm.expect(p.distance_km).to.be.a('number'));",
                      "});",
                      "",
                      "pm.test('Results are sorted by distance ASC', () => {",
                      "  for (let i = 1; i < json.data.length; i++) {",
                      "    pm.expect(json.data[i].distance_km).to.be.at.least(json.data[i - 1].distance_km);",
                      "  }",
                      "});",
                      "",
                      "pm.test('CW distance_km is less than radius (10 km)', () => {",
                      "  const cw = json.data.find(p => p.id === pm.collectionVariables.get('CW_ID'));",
                      "  pm.expect(cw.distance_km).to.be.below(10);",
                      "});"
                    ]
                  }
                }
              ]
            },
