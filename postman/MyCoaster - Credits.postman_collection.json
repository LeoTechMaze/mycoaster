    {
      "name": "GET /credits/me",
      "item": [
        {
          "name": "List my credits (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "",
                  "pm.test('data is an array', () => {",
                  "  pm.expect(json.data).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('Each credit has required fields', () => {",
                  "  json.data.forEach(c => {",
                  "    pm.expect(c.id).to.be.a('string');",
                  "    pm.expect(c.coaster_id).to.be.a('string');",
                  "    pm.expect(c.coaster_name).to.be.a('string');",
                  "    pm.expect(c.park_id).to.be.a('string');",
                  "    pm.expect(c.park_name).to.be.a('string');",
                  "    pm.expect(c.ridden_at).to.be.a('string');",
                  "  });",
                  "});",
                  "",
                  "if (json.data.length > 0) {",
                  "  pm.test('Results are ordered by ridden_at DESC', () => {",
                  "    for (let i = 1; i < json.data.length; i++) {",
                  "      pm.expect(new Date(json.data[i].ridden_at).getTime())",
                  "        .to.be.at.most(new Date(json.data[i - 1].ridden_at).getTime());",
                  "    }",
                  "  });",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
