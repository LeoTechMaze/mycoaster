  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Auto-generate a signed JWT so every request in this collection is authenticated.",
          "// Uses CryptoJS (built into Postman sandbox) — no external library needed.",
          "",
          "function b64url(str) {",
          "  return CryptoJS.enc.Base64.stringify(CryptoJS.enc.Utf8.parse(str))",
          "    .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=/g, '');",
          "}",
          "",
          "const now = Math.floor(Date.now() / 1000);",
          "const header  = b64url(JSON.stringify({ alg: 'HS256', typ: 'JWT' }));",
          "const payload = b64url(JSON.stringify({",
          "  sub:   pm.collectionVariables.get('USER_ID'),",
          "  email: pm.collectionVariables.get('USER_EMAIL'),",
          "  iat:   now,",
          "  exp:   now + 3600",
          "}));",
          "",
          "const signingInput = `${header}.${payload}`;",
          "const sig = CryptoJS.HmacSHA256(signingInput, pm.collectionVariables.get('JWT_SECRET'));",
          "const sigB64 = CryptoJS.enc.Base64.stringify(sig)",
          "  .replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=/g, '');",
          "",
          "pm.collectionVariables.set('authToken', `${signingInput}.${sigB64}`);"
        ],
        "type": "text/javascript"
      }
    }
  ],
