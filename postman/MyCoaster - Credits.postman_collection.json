      "name": "POST /credits",
      "item": [
        {
          "name": "Add credit — Leviathan (201)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "",
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "",
                  "pm.test('Returns the created credit with id, coaster_id and ridden_at', () => {",
                  "  pm.expect(json.data.id).to.be.a('string');",
                  "  pm.expect(json.data.coaster_id).to.eql(pm.collectionVariables.get('CW_LEVIATHAN_ID'));",
                  "  pm.expect(json.data.ridden_at).to.be.a('string');",
                  "});",
                  "",
                  "// Persist credit id so other requests can reference it",
                  "pm.collectionVariables.set('lastCreditId', json.data.id);"
                ],
                "type": "text/javascript"
              }
            }
