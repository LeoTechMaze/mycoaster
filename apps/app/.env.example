# Base URL of the apps/api server. On a physical device, localhost refers to
# the device itself, not your dev machine — use your machine's LAN IP instead
# (e.g. http://192.168.1.20:3000). On an iOS/Android simulator on the same
# machine as the api, localhost works.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Firebase Console → Authentication → Sign-in method → enable Google → auto-generated
# "Web client ID" (not the iOS or Android client ID). Required for Google Sign-In.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
