# ─── Node ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=coaster
POSTGRES_PASSWORD=coaster_secret
POSTGRES_DB=coaster_tracker

# (Optional) Full connection string — overrides individual fields in production
# DATABASE_URL=postgresql://coaster:coaster_secret@localhost:5432/coaster_tracker

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=

# ─── JWT ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# ─── Firebase Admin ──────────────────────────────────────────────────────────
# Path to the Firebase service account JSON downloaded from the Firebase Console
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ─── Cache TTLs (seconds) ─────────────────────────────────────────────────────
LEADERBOARD_CACHE_TTL=300
