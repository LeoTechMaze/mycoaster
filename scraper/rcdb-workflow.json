      "id": "node-fetch-park-page",
      "name": "Fetch Park Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2560,
        544
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst dedupItems = $('Deduplicate Parks & Coasters').all();\n\nreturn items.map((item, index) => {\n  const rawItem = item.json;\n  const dedupItem = dedupItems[index]?.json || {};\n\n  if (rawItem.error || !rawItem.data) {\n    const rcdb_id = dedupItem.rcdb_id;\n    console.error(`[Park ${rcdb_id}] HTTP error:`, rawItem.error || 'no data');\n    return { json: { rcdb_id, name: null, city: null, country: null, latitude: null, longitude: null, _error: true } };\n  }\n\n  const html = rawItem.data;\n  const rcdb_id = dedupItem.rcdb_id;\n  const _all_coasters = dedupItem._all_coasters || [];\n\n  const nameMatch = html.match(/<h1>([^<]+)<\\/h1>/);\n  const name = nameMatch ? nameMatch[1].trim() : null;\n\n  const coordMatch = html.match(/google\\.com\\/maps\\/place\\/(-?\\d+\\.\\d+),(-?\\d+\\.\\d+)/);\n  const latitude = coordMatch ? parseFloat(coordMatch[1]) : null;\n  const longitude = coordMatch ? parseFloat(coordMatch[2]) : null;\n\n  const locationLinkRegex = /location\\.htm\\?id=\\d+\">([^<]+)<\\/a>/g;\n  const locationParts = [];\n  let locMatch;\n  while ((locMatch = locationLinkRegex.exec(html)) !== null) {\n    locationParts.push(locMatch[1].trim());\n  }\n\n  let city = null, country = null;\n  if (locationParts.length >= 3) { city = locationParts[0]; country = locationParts[locationParts.length - 1]; }\n  else if (locationParts.length === 2) { city = locationParts[0]; country = locationParts[1]; }\n  else if (locationParts.length === 1) { country = locationParts[0]; }\n\n  console.log(`[Park ${rcdb_id}] name=${name}, city=${city}, country=${country}, lat=${latitude}, lng=${longitude}`);\n\n  return { json: { rcdb_id, name, city, country, latitude, longitude, _all_coasters, synced_at: new Date().toISOString() } };\n});"
      },
