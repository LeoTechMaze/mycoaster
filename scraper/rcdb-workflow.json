      "name": "Wait 500ms (listing)",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        1568,
        544
      ],
      "webhookId": "534783f7-c2c1-4624-8540-58e11cc7215a"
