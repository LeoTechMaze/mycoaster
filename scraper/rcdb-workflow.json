    {
      "parameters": {
        "jsCode": "const inputs = $input.all();\nconst splitItems = $('Split Countries').all();\n\nreturn inputs.map((item, index) => {\n  const html = item.json.data || '';\n  const splitItem = splitItems[index]?.json || {};\n  const location_id = splitItem.location_id;\n  const country_name = splitItem.name;\n\n  const pageMatch = html.match(/Page\\s+\\d+\\s+of\\s+(\\d+)/);\n  const totalPages = pageMatch ? parseInt(pageMatch[1]) : 1;\n\n  console.log(`[${country_name}] Total pages: ${totalPages}`);\n\n  return { json: { location_id, country_name, totalPages } };\n});"
      },
      "id": "node-extract-total-pages",
      "name": "Extract Total Pages",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1152,
        544
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().flatMap(item => {\n  const { location_id, country_name, totalPages } = item.json;\n  const pages = [];\n\n  for (let page = 1; page <= totalPages; page++) {\n    pages.push({ json: { url: `https://rcdb.com/r.htm?ot=2&ol=${location_id}&page=${page}`, page, location_id, country_name } });\n  }\n\n  console.log(`[${country_name}] Generated ${pages.length} page URLs`);\n  return pages;\n});"
      },
      "id": "node-gen-page-urls",
      "name": "Generate Page URLs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1376,
        544
      ]
    },
    {
      "parameters": {
        "amount": 0.5
      },
