    {
      "parameters": {
        "jsCode": "const coastersMap = {};\nfor (const item of $input.all()) {\n  const coasters = item.json._all_coasters || [];\n  for (const c of coasters) {\n    if (c.coaster_rcdb_id) { coastersMap[c.coaster_rcdb_id] = c; }\n  }\n}\nconst coasters = Object.values(coastersMap);\nconsole.log(`Emitting ${coasters.length} coasters for upsert`);\nreturn coasters.map(c => ({ json: c }));"
      },
      "id": "node-emit-coasters",
      "name": "Emit Coasters",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3392,
        336
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO coasters (id, name, park_id, rcdb_id, synced_at)\nSELECT\n  gen_random_uuid(),\n  $1,\n  p.id,\n  $2,\n  NOW()\nFROM parks p\nWHERE p.rcdb_id = $3\nON CONFLICT (rcdb_id) DO UPDATE SET\n  name      = EXCLUDED.name,\n  park_id   = EXCLUDED.park_id,\n  synced_at = NOW()\nWHERE\n  coasters.name    IS DISTINCT FROM EXCLUDED.name    OR\n  coasters.park_id IS DISTINCT FROM EXCLUDED.park_id",
        "options": {
          "queryReplacement": "={{ $json.coaster_name }}, {{ $json.coaster_rcdb_id }}, {{ $json.park_rcdb_id }}"
        }
      },
