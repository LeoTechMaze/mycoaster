      "id": "node-fetch-listing-page",
      "name": "Fetch Listing Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1776,
        544
      ],
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const results = [];\n\nfor (const item of $input.all()) {\n  const html = item.json.data || '';\n  const page = item.json.page || '?';\n\n  // Match each table row\n  const rowRegex = /<tr[^>]*>([\\s\\S]*?)(?=<tr|<\\/tbody|<\\/table|$)/gi;\n  let rowMatch;\n\n  while ((rowMatch = rowRegex.exec(html)) !== null) {\n    const row = rowMatch[1];\n    // RCDB uses unquoted hrefs: href=/1234.htm\n    const linkRegex = /href=\\/(\\d+)\\.htm[^>]*>([^<]+)<\\/a>/g;\n    const links = [];\n    let linkMatch;\n\n    while ((linkMatch = linkRegex.exec(row)) !== null) {\n      links.push({ rcdb_id: linkMatch[1], name: linkMatch[2].trim() });\n    }\n\n    if (links.length >= 2) {\n      results.push({\n        coaster_rcdb_id: links[0].rcdb_id,\n        coaster_name: links[0].name,\n        park_rcdb_id: links[1].rcdb_id,\n        park_name: links[1].name\n      });\n    }\n  }\n}\n\nconsole.log(`Total coaster/park pairs: ${results.length}`);\nreturn results.map(r => ({ json: r }));"
      },
      "id": "node-parse-listing-page",
      "name": "Parse Listing Page",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1968,
        544
      ],
      "alwaysOutputData": true,
      "continueOnFail": true
    },
    {
      "parameters": {
        "jsCode": "const allItems = $input.all();\nconst coastersMap = {};\nconst parksMap = {};\nfor (const item of allItems) {\n  const d = item.json;\n  if (!d.coaster_rcdb_id || !d.park_rcdb_id) continue;\n  coastersMap[d.coaster_rcdb_id] = { coaster_rcdb_id: d.coaster_rcdb_id, coaster_name: d.coaster_name, park_rcdb_id: d.park_rcdb_id };\n  parksMap[d.park_rcdb_id] = { rcdb_id: d.park_rcdb_id, name: d.park_name };\n}\nconst parks = Object.values(parksMap);\nconst coasters = Object.values(coastersMap);\nconsole.log(`Deduplicated: ${parks.length} unique parks, ${coasters.length} unique coasters`);\nreturn parks.map(p => ({ json: { ...p, _all_coasters: coasters.filter(c => c.park_rcdb_id === p.rcdb_id) } }));"
      },
      "id": "node-deduplicate",
      "name": "Deduplicate Parks & Coasters",
