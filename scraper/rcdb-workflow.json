    {
      "parameters": {
        "jsCode": "const results = $input.all();\nconst errors = results.filter(r => r.json.error);\nconsole.log(`[RCDB Scraper] Completed. Total: ${results.length}, errors: ${errors.length}`);\nreturn [{ json: { done: true, total: results.length, errors: errors.length, timestamp: new Date().toISOString() } }];"
      },
      "id": "node-summary",
