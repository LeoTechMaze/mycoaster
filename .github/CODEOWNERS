/apps/api/src/config/               @LeoTechMaze
app.config.*                        @LeoTechMaze
/apps/app/app.json                  @LeoTechMaze
eas.json                            @LeoTechMaze

# Database
/apps/api/migrations/               @LeoTechMaze

# Infra and CI
